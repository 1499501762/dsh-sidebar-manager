{
  "name": "dsh-sidebar-manager",
  "version": "1.0.2",
  "description": "DSH web plugin: manage the left sidebar and the conversation top bar as menu trees — reorder, group, custom icons, show/hide, drag & drop, cross-surface proxy moves (experimental), plus a window API so agents can do it.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": {
    "name": "1499501762",
    "url": "https://github.com/1499501762"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1499501762/dsh-sidebar-manager.git"
  },
  "homepage": "https://github.com/1499501762/dsh-sidebar-manager#readme",
  "bugs": {
    "url": "https://github.com/1499501762/dsh-sidebar-manager/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "sidebar",
    "sidebar-manager",
    "topbar",
    "menu",
    "ui",
    "plugin"
  ],
  "scripts": {
    "check": "node --check lib/client.js && node --check lib/index.js"
  }
}
